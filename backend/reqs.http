### Login to get a token (send this one first)
# @name login
@baseUrl = http://localhost:3000/api
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "sarah.ben.ali@example.com",
  "password": "Password123!"
}


### Get my profile (expect 200, Sarah with her skills)
GET {{baseUrl}}/users/me
Authorization: Bearer {{login.response.body.token}}

### Get my profile without a token (expect 401)
GET {{baseUrl}}/users/me

### Get my profile with a fake token (expect 401)
GET {{baseUrl}}/users/me
Authorization: Bearer not-a-real-token

### All skills (expect 37)
GET {{baseUrl}}/skills

### Skills filtered by category (expect 5 DIY skills)
GET {{baseUrl}}/skills?category=diy

### Skills filtered by text (expect Python)
GET {{baseUrl}}/skills?q=py


### Update my profile and skills (expect 200, send the login request first)
PUT {{baseUrl}}/users/me
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "Sarah Ben Ali",
  "bio": "Updated bio from the API",
  "university": "SUP'COM",
  "year": 2,
  "city": "Tunis",
  "skills": [
    { "skillId": 8, "type": "teach", "level": "advanced", "mode": "online" },
    { "skillId": 1, "type": "learn", "level": "beginner", "mode": "online" }
  ]
}

### Check that the changes were saved (expect the new bio and 2 skills)
GET {{baseUrl}}/users/me
Authorization: Bearer {{login.response.body.token}}

### Unknown skill (expect 400)
PUT {{baseUrl}}/users/me
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "Sarah Ben Ali",
  "skills": [
    { "skillId": 9999, "type": "teach", "level": "advanced", "mode": "online" }
  ]
}

### Duplicate skill (expect 400)
PUT {{baseUrl}}/users/me
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "Sarah Ben Ali",
  "skills": [
    { "skillId": 1, "type": "teach", "level": "advanced", "mode": "online" },
    { "skillId": 1, "type": "teach", "level": "beginner", "mode": "online" }
  ]
}

### Invalid fields (expect 400 with details)
PUT {{baseUrl}}/users/me
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "S",
  "year": 99
}

### No token (expect 401)
PUT {{baseUrl}}/users/me
Content-Type: application/json

{
  "name": "Sarah Ben Ali"
}


### All users (expect 200, total around 19-20, 20 items max)
GET {{baseUrl}}/users
Authorization: Bearer {{login.response.body.token}}

### Teachers of a DIY skill (expect 2: Amine and Fedi)
GET {{baseUrl}}/users?category=diy
Authorization: Bearer {{login.response.body.token}}

### Teachers of a tech skill (expect 5)
GET {{baseUrl}}/users?category=tech
Authorization: Bearer {{login.response.body.token}}

### Advanced in-person teachers (expect 4)
GET {{baseUrl}}/users?mode=in_person&level=advanced
Authorization: Bearer {{login.response.body.token}}

### By city, case-insensitive (expect 2: Bizerte)
GET {{baseUrl}}/users?city=bizerte
Authorization: Bearer {{login.response.body.token}}

### By name (expect Karim)
GET {{baseUrl}}/users?q=kar
Authorization: Bearer {{login.response.body.token}}

### Pagination (expect 5 items, page 2)
GET {{baseUrl}}/users?page=2&pageSize=5
Authorization: Bearer {{login.response.body.token}}

### Invalid page size (expect 400)
GET {{baseUrl}}/users?pageSize=500
Authorization: Bearer {{login.response.body.token}}

### Search without a token (expect 401)
GET {{baseUrl}}/users

### A public profile (expect 200, and NO email field)
GET {{baseUrl}}/users/2
Authorization: Bearer {{login.response.body.token}}

### Unknown user (expect 404)
GET {{baseUrl}}/users/9999
Authorization: Bearer {{login.response.body.token}}

### user 20
GET {{baseUrl}}/users/190
Authorization: Bearer {{login.response.body.token}}


### My matches as Sarah (expect Karim 50 and Slim 50, each with theyTeachMe and iTeachThem)
GET {{baseUrl}}/matches
Authorization: Bearer {{login.response.body.token}}

### Limit (expect 1 item)
GET {{baseUrl}}/matches?limit=1
Authorization: Bearer {{login.response.body.token}}

### Invalid limit (expect 400)
GET {{baseUrl}}/matches?limit=0
Authorization: Bearer {{login.response.body.token}}

### Without a token (expect 401)
GET {{baseUrl}}/matches



### Make Sarah the mirror of Karim (expect 200)
PUT {{baseUrl}}/users/me
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "Sarah Ben Ali",
  "skills": [
    { "skillId": 8, "type": "teach", "level": "advanced", "mode": "online" },
    { "skillId": 30, "type": "teach", "level": "beginner", "mode": "online" },
    { "skillId": 1, "type": "learn", "level": "beginner", "mode": "online" },
    { "skillId": 6, "type": "learn", "level": "beginner", "mode": "online" }
  ]
}




### Set my availability (expect 200, sorted by weekday)
PUT {{baseUrl}}/users/me/availability
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "windows": [
    { "weekday": 3, "startTime": "17:00", "endTime": "19:00" },
    { "weekday": 1, "startTime": "18:00", "endTime": "20:00" }
  ]
}

### Clear my availability (expect 200 with an empty list)
PUT {{baseUrl}}/users/me/availability
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "windows": [] }

### End before start (expect 400)
PUT {{baseUrl}}/users/me/availability
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "windows": [ { "weekday": 1, "startTime": "20:00", "endTime": "18:00" } ] }

### Overlap on the same day (expect 400)
PUT {{baseUrl}}/users/me/availability
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "windows": [
    { "weekday": 1, "startTime": "18:00", "endTime": "20:00" },
    { "weekday": 1, "startTime": "19:00", "endTime": "21:00" }
  ]
}

### Invalid time and weekday (expect 400 with details)
PUT {{baseUrl}}/users/me/availability
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "windows": [ { "weekday": 8, "startTime": "25:00", "endTime": "26:00" } ] }

### Karim's availability (expect Tuesday 18:00-20:00 and Thursday 17:00-19:00, busy empty)
GET {{baseUrl}}/users/2/availability
Authorization: Bearer {{login.response.body.token}}

### Unknown user (expect 404)
GET {{baseUrl}}/users/9999/availability
Authorization: Bearer {{login.response.body.token}}

### Without a token (expect 401)
GET {{baseUrl}}/users/2/availability

### Request a session (expect 201, status pending, teacher Karim, skill Python)
POST {{baseUrl}}/sessions
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "teacherId": 2,
  "skillId": 1,
  "startAt": "2026-11-24T18:00:00+01:00",
  "durationMinutes": 60,
  "message": "Hi Karim, I would love to start with Python basics."
}

### Same instant written in UTC (expect 409, already requested)
POST {{baseUrl}}/sessions
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "teacherId": 2, "skillId": 1, "startAt": "2026-11-24T17:00:00Z", "durationMinutes": 60 }

### Ends after the window closes at 20:00 (expect 400)
POST {{baseUrl}}/sessions
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "teacherId": 2, "skillId": 1, "startAt": "2026-11-24T19:30:00+01:00", "durationMinutes": 60 }

### Wrong weekday, a Wednesday (expect 400)
POST {{baseUrl}}/sessions
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "teacherId": 2, "skillId": 1, "startAt": "2026-11-25T18:00:00+01:00", "durationMinutes": 60 }

### Not on a half hour (expect 400)
POST {{baseUrl}}/sessions
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "teacherId": 2, "skillId": 1, "startAt": "2026-11-24T18:15:00+01:00", "durationMinutes": 60 }

