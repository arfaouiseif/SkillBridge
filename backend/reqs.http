POST {{baseUrl}}/sessions
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "teacherId": 2, "skillId": 1, "startAt": "2020-01-07T18:00:00+01:00", "durationMinutes": 60 }

