### Login to get a token (send this one first)
# @name login
@baseUrl = http://localhost:3000/api
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "sarah.ben.ali@example.com",
  "password": "Password123!"
}


### Get my profile (expect 200, Sarah with her skills)
GET {{baseUrl}}/users/me
Authorization: Bearer {{login.response.body.token}}

### Get my profile without a token (expect 401)
GET {{baseUrl}}/users/me

### Get my profile with a fake token (expect 401)
GET {{baseUrl}}/users/me
Authorization: Bearer not-a-real-token

### All skills (expect 37)
GET {{baseUrl}}/skills

### Skills filtered by category (expect 5 DIY skills)
GET {{baseUrl}}/skills?category=diy

### Skills filtered by text (expect Python)
GET {{baseUrl}}/skills?q=py


### Update my profile and skills (expect 200, send the login request first)
PUT {{baseUrl}}/users/me
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "Sarah Ben Ali",
  "bio": "Updated bio from the API",
  "university": "SUP'COM",
  "year": 2,
  "city": "Tunis",
  "skills": [
    { "skillId": 8, "type": "teach", "level": "advanced", "mode": "online" },
    { "skillId": 1, "type": "learn", "level": "beginner", "mode": "online" }
  ]
}

### Check that the changes were saved (expect the new bio and 2 skills)
GET {{baseUrl}}/users/me
Authorization: Bearer {{login.response.body.token}}

### Unknown skill (expect 400)
PUT {{baseUrl}}/users/me
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "Sarah Ben Ali",
  "skills": [
    { "skillId": 9999, "type": "teach", "level": "advanced", "mode": "online" }
  ]
}

### Duplicate skill (expect 400)
PUT {{baseUrl}}/users/me
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "Sarah Ben Ali",
  "skills": [
    { "skillId": 1, "type": "teach", "level": "advanced", "mode": "online" },
    { "skillId": 1, "type": "teach", "level": "beginner", "mode": "online" }
  ]
}

### Invalid fields (expect 400 with details)
PUT {{baseUrl}}/users/me
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "S",
  "year": 99
}

### No token (expect 401)
PUT {{baseUrl}}/users/me
Content-Type: application/json

{
  "name": "Sarah Ben Ali"
}